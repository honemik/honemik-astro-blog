---
interface Props {
  text: string;
  color?: string;
}

const { text, color = 'var(--color-wood)' } = Astro.props;
---

<div class="vertical-label-wrapper">
  <div class="vertical-label font-hand text-vertical" style={`color: ${color};`}>
    {text}
  </div>
  <div class="vertical-line" style={`background-color: ${color};`}></div>
</div>

<style>
  .vertical-label-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }
  
  .vertical-label {
    font-size: 1.25rem;
  }

  .vertical-line {
    width: 1px;
    height: 40px;
  }
</style>
