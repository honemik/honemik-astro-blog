---
import { site } from '../data/site';
---

<footer class="site-footer">
  <a class="page-top-link" href="#main-content" aria-label="Back to page top">Page<br />Top</a>
  <div class="wrap footer-layout">
    <div class="footer-brand">
      <span class="brand-mark" aria-hidden="true">hm</span>
      <span>
        <strong>{site.title}</strong>
        <small>{site.description}</small>
      </span>
    </div>

    <nav class="footer-nav" aria-label="Footer navigation">
      {site.nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <div class="footer-links">
      {site.resources.map((item) => (
        <a href={item.href} class="external-block" target={item.href.startsWith('http') ? '_blank' : undefined} rel={item.href.startsWith('http') ? 'noopener' : undefined}>
          <strong>{item.label}</strong>
          <span>{item.description}</span>
        </a>
      ))}
    </div>

    <div class="footer-social" aria-label="Social links">
      {site.social.map((item) => (
        <a href={item.href} target={item.href.startsWith('http') ? '_blank' : undefined} rel={item.href.startsWith('http') ? 'noopener' : undefined}>
          {item.label}
        </a>
      ))}
    </div>

    <p class="copyright">Copyright © {new Date().getFullYear()} {site.author}. All Rights Reserved.</p>
  </div>
</footer>
