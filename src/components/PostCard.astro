---
import { formatDate, getExcerpt, getPostCover, readingMinutes, type BlogPost } from '../utils/posts';

interface Props {
  post: BlogPost;
  featured?: boolean;
}

const { post, featured = false } = Astro.props;
const cover = getPostCover(post);
const transitionName = `post-cover-${post.slug.replace(/[^a-zA-Z0-9_-]/g, '-')}`;
---

<article class={`post-card ${featured ? 'post-card--featured' : ''}`}>
  <a class="post-card__media" href={`/posts/${post.slug}/`} aria-label={`Read ${post.data.title}`} style={`--post-transition-name: ${transitionName};`}>
    {cover ? (
      <>
        <img src={cover} alt="" loading="lazy" />
        <img class="post-card__media-ghost" src={cover} alt="" aria-hidden="true" loading="lazy" />
      </>
    ) : (
      <span class="post-card__placeholder" aria-hidden="true">
        <span>{post.data.tags[0] ?? 'note'}</span>
      </span>
    )}
  </a>
  <div class="post-card__body">
    <div class="post-meta">
      <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
      <span>{readingMinutes(post)} min read</span>
    </div>
    <h3><a href={`/posts/${post.slug}/`}>{post.data.title}</a></h3>
    <p>{getExcerpt(post)}</p>
    <div class="term-list" aria-label="Post tags">
      {post.data.tags.map((tag) => <a href={`/tags/${tag.toLowerCase()}/`}>{tag}</a>)}
      {post.data.categories.map((category) => <a href={`/categories/${category.toLowerCase()}/`}>{category}</a>)}
    </div>
  </div>
</article>
