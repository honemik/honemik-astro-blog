---
import { formatDate, getPostCover, readingMinutes, type BlogPost } from '../utils/posts';

interface Props {
  post: BlogPost;
  headings?: Array<{ depth: number; slug: string; text: string }>;
  newer?: BlogPost;
  older?: BlogPost;
}

const { post, headings = [], newer, older } = Astro.props;
const cover = getPostCover(post);
const tocHeadings = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

<article class="article-page">
  <header class="article-hero wrap">
    <a class="back-link font-hand" href="/posts/">&larr; Back to all posts</a>
    <div class="article-title-card" style="border-radius: var(--radius-lg); padding: 3rem 2rem; text-align: center; background: var(--color-paper); box-shadow: var(--shadow-soft);">
      <div class="post-meta font-hand" style="justify-content: center; font-size: 1.2rem; color: var(--color-wood);">
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        <span>&middot;</span>
        <span>{readingMinutes(post)} min read</span>
      </div>
      <h1 style="margin-top: 1rem; font-size: clamp(2rem, 5vw, 3rem);">{post.data.title}</h1>
      {post.data.description && <p class="micro-caption" style="margin-top: 1rem;">{post.data.description}</p>}
      <div class="term-list" style="justify-content: center; margin-top: 2rem;">
        {post.data.tags.map((tag) => <a href={`/tags/${tag.toLowerCase()}/`}>{tag}</a>)}
        {post.data.categories.map((category) => <a href={`/categories/${category.toLowerCase()}/`}>{category}</a>)}
      </div>
    </div>
    {cover && (
      <figure class="article-cover">
        <img src={cover} alt="" loading="lazy" />
      </figure>
    )}
  </header>

  <div class="article-layout wrap">
    {tocHeadings.length > 0 && (
      <aside class="article-toc" aria-label="Table of contents">
        <strong>Contents</strong>
        <nav>
          {tocHeadings.map((heading) => (
            <a class={`toc-depth-${heading.depth}`} href={`#${heading.slug}`}>{heading.text}</a>
          ))}
        </nav>
      </aside>
    )}

    <div class="article-content prose">
      <slot />
    </div>
  </div>

  <nav class="post-neighbors wrap" aria-label="Post navigation">
    {newer ? (
      <a href={`/posts/${newer.slug}/`}>
        <span>Newer</span>
        <strong>{newer.data.title}</strong>
      </a>
    ) : <span></span>}
    {older ? (
      <a href={`/posts/${older.slug}/`}>
        <span>Older</span>
        <strong>{older.data.title}</strong>
      </a>
    ) : <span></span>}
  </nav>
</article>
