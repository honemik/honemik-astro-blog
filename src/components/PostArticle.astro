---
import { formatDate, readingMinutes, termSlug, type BlogPost } from '../utils/posts';

interface Props {
  post: BlogPost;
  headings?: Array<{ depth: number; slug: string; text: string }>;
  newer?: BlogPost;
  older?: BlogPost;
}

const { post, headings = [], newer, older } = Astro.props;
const tocHeadings = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const primaryTerm = post.data.categories[0] ?? post.data.tags[0] ?? 'Note';
const searchTerms = [...post.data.categories, ...post.data.tags].join(' ');
---

<article class="article-page" data-pagefind-body>
  <header class="article-editorial-hero wrap">
    <div class="article-action-row">
      {post.data.ShowBreadCrumbs && <a class="back-link" href="/posts/">Back to all posts</a>}
      <button class="copy-link-button" type="button" data-copy-link data-copy-url={Astro.url.href} aria-live="polite">
        <span data-copy-label>Copy link</span>
      </button>
    </div>
    <div class="article-kicker-row">
      <p class="kicker">{primaryTerm}</p>
      <div class="meta-row">
        <time datetime={post.data.date.toISOString()} data-pagefind-meta="date">{formatDate(post.data.date)}</time>
        <span>{readingMinutes(post)} min read</span>
      </div>
    </div>
    <h1>{post.data.title}</h1>
    {post.data.description && <p class="article-deck">{post.data.description}</p>}
    {searchTerms && <span class="visually-hidden" data-pagefind-meta="terms">{searchTerms}</span>}
  </header>

  <div class="article-editorial-layout wrap">
    <aside class="article-side-rail" aria-label="Article metadata">
      <div class="article-progress" aria-hidden="true">
        <span data-article-progress></span>
      </div>

      <section>
        <p class="kicker">PUBLISHED</p>
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
      </section>

      <section>
        <p class="kicker">TAGS</p>
        <div class="side-term-list">
          {post.data.categories.map((category) => <a href={`/categories/${termSlug(category)}/`}>{category}</a>)}
          {post.data.tags.map((tag) => <a href={`/tags/${termSlug(tag)}/`}>{tag}</a>)}
        </div>
      </section>

      {post.data.ShowToc && tocHeadings.length > 0 && (
        <section class="article-toc" aria-label="Table of contents">
          <p class="kicker">CONTENTS</p>
          <nav>
            {tocHeadings.map((heading) => (
              <a class={`toc-depth-${heading.depth}`} href={`#${heading.slug}`} data-toc-link>{heading.text}</a>
            ))}
          </nav>
        </section>
      )}

    </aside>

    <div class="article-content-shell">
      <div class="article-content prose" data-article-body>
        <slot />
      </div>
    </div>
  </div>

  <nav class="post-neighbors wrap" aria-label="Post navigation">
    {newer ? (
      <a href={`/posts/${newer.slug}/`}>
        <span>Newer</span>
        <strong>{newer.data.title}</strong>
      </a>
    ) : <span></span>}
    {older ? (
      <a href={`/posts/${older.slug}/`}>
        <span>Older</span>
        <strong>{older.data.title}</strong>
      </a>
    ) : <span></span>}
  </nav>
</article>

<script>
  const observerOptions = {
    root: null,
    rootMargin: '0px 0px -10% 0px',
    threshold: 0
  };

  const observer = new IntersectionObserver((entries, observer) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
        observer.unobserve(entry.target);
      }
    });
  }, observerOptions);

  document.querySelectorAll('.article-content img').forEach(img => {
    img.classList.add('reveal-image');
    if (img.complete) {
      observer.observe(img);
    } else {
      img.addEventListener('load', () => observer.observe(img));
    }
  });
</script>
