---
import type { BlogPost } from '../utils/posts';
import { formatDate } from '../utils/posts';

interface Props {
  post: BlogPost;
  index?: number;
}

const { post, index = 0 } = Astro.props;

// Use images 1, 2, 3, 4 for the cards based on the index
const imageMap = ['1.jpg', '2.jpg', '3.jpg', '4.jpg'];
const imgFileName = imageMap[index % imageMap.length];
const imgSrc = `/assets/img/Background/${imgFileName}`;
---

<a href={`/posts/${post.slug}/`} class="editorial-card">
  <div class="editorial-card__media">
    <img src={imgSrc} alt={post.data.title} style="width: 100%; height: 100%; object-fit: cover;" loading="lazy" />
  </div>
  <div class="editorial-card__content">
    <div class="editorial-card__meta font-hand text-vertical">
      {formatDate(post.data.date)}
    </div>
    <div class="editorial-card__text">
      <h3>{post.data.title}</h3>
      <p class="micro-caption">{post.data.description || 'A gentle note about life and creation.'}</p>
    </div>
  </div>
</a>

<style>
  .editorial-card {
    display: flex;
    flex-direction: column;
    gap: 16px;
    text-decoration: none;
    color: inherit;
    transition: opacity 0.2s ease;
  }
  
  .editorial-card:hover {
    opacity: 0.8;
  }
  
  .editorial-card__media {
    aspect-ratio: 1 / 1;
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .editorial-card__content {
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }

  .editorial-card__meta {
    font-size: 1.1rem;
    color: var(--color-wood);
    padding-top: 4px;
    flex-shrink: 0;
  }

  .editorial-card__text h3 {
    margin: 0 0 8px 0;
    font-size: 1.25rem;
    line-height: 1.4;
    font-weight: 500;
  }
  
  .editorial-card__text p {
    margin: 0;
  }
</style>
