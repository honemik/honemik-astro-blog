---
import type { BlogPost } from '../utils/posts';
import { formatDate, getExcerpt, getPostCover, readingMinutes } from '../utils/posts';

interface Props {
  post: BlogPost;
  index?: number;
  variant?: 'feature' | 'medium' | 'compact' | 'textOnly';
}

const { post, index = 0, variant = 'medium' } = Astro.props;

// Use images 1, 2, 3, 4 for the cards based on the index
const imageMap = ['1.jpg', '2.jpg', '3.jpg', '4.jpg'];
const imgFileName = imageMap[index % imageMap.length];
const imgSrc = getPostCover(post) || `/assets/img/Background/${imgFileName}`;
const primaryTerm = post.data.categories[0] ?? post.data.tags[0] ?? 'Note';
const transitionName = `post-cover-${post.slug.replace(/[^a-zA-Z0-9_-]/g, '-')}`;
---

<a href={`/posts/${post.slug}/`} class={`editorial-card editorial-card--${variant}`}>
  {variant !== 'textOnly' && (
    <div class="editorial-card__media" style={`--post-transition-name: ${transitionName};`}>
      <img src={imgSrc} alt="" loading="lazy" />
      <img class="editorial-card__media-ghost" src={imgSrc} alt="" aria-hidden="true" loading="lazy" />
      {variant === 'feature' && <span class="editorial-card__term">{primaryTerm}</span>}
    </div>
  )}
  <div class="editorial-card__body">
    <div class="editorial-card__meta">
      <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
      <span>{readingMinutes(post)} min read</span>
      {variant !== 'compact' && <span>{primaryTerm}</span>}
    </div>
    <h3>{post.data.title}</h3>
    {variant !== 'compact' && <p>{post.data.description || getExcerpt(post, variant === 'feature' ? 110 : 72)}</p>}
    <span class="editorial-card__read">Read note</span>
  </div>
</a>
