---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import { getAllPosts, getTags, termSlug } from '../../utils/posts';

const tags = getTags(await getAllPosts());
---

<BaseLayout title="Tags" description="Tags used across the honemik blog archive.">
  <section class="page-hero wrap page-hero--editorial tag-index-hero">
    <SectionHeader eyebrow="Topic index" title="Tags" align="center" level={1} />
    <div class="tag-index-panel">
      <div class="tag-index-panel__rail">
        <span>索引</span>
        <small>{tags.length} topics</small>
      </div>
      <div class="department-term-grid tag-term-grid">
      {tags.map(([tag, count], index) => (
        <a class="department-term tag-term" href={`/tags/${termSlug(tag)}/`}>
          <span>{String(index + 1).padStart(2, '0')}</span>
          <strong>{tag}</strong>
          <small>{count} notes</small>
        </a>
      ))}
      </div>
    </div>
  </section>
</BaseLayout>
