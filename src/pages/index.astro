---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { formatDate, getAllPosts, getExcerpt, readingMinutes } from '../utils/posts';
import { readdirSync } from 'node:fs';

const posts = await getAllPosts();
const featured = posts.find((post) => post.data.title.includes('CMS')) ?? posts[0];
const latest = posts.filter((post) => post.slug !== featured?.slug).slice(0, 3);
const backgroundImages = readdirSync(new URL('../../public/assets/img/Background/', import.meta.url))
  .filter((file) => /\.(?:avif|jpe?g|png|webp)$/i.test(file))
  .sort((a, b) => a.localeCompare(b, undefined, { numeric: true }))
  .map((file) => `/assets/img/Background/${file}`);
const fallbackHeroImage = backgroundImages.includes('/assets/img/Background/6.jpg')
  ? '/assets/img/Background/6.jpg'
  : backgroundImages[0];

const browseItems = [
  {
    number: '01',
    title: 'Posts',
    description: 'Recent notes, projects, and study fragments.',
    href: '/posts/'
  },
  {
    number: '02',
    title: 'Archive',
    description: 'A chronological index for slower browsing.',
    href: '/archive/'
  },
  {
    number: '03',
    title: 'Tags',
    description: 'Small topic paths through the notebook.',
    href: '/tags/'
  }
];
---

<BaseLayout title={site.title} description={site.longDescription}>
  <section class="quiet-cover wrap" aria-labelledby="cover-title">
    <figure class="quiet-cover__media" data-hero-media>
      <img
        src={fallbackHeroImage}
        alt="Layered seasonal cover image"
        data-hero-image
        decoding="async"
        fetchpriority="high"
      />
    </figure>
    <span class="cover-change-folio" aria-hidden="true" data-cover-folio>01</span>

    <div class="quiet-cover__copy">
      <h1 id="cover-title" class="quiet-cover__title">
        <button class="hero-word" type="button" aria-label="Switch cover image" data-hero-title>
          <span class="word word-en">honemik</span>
          <span class="word word-zh">蜂蜜牛奶</span>
        </button>
      </h1>
      <div class="quiet-cover__subtitles" aria-label="Primary homepage links">
        {featured && <a class="hand-subtitle" href={`/posts/${featured.slug}/`}>最近的一頁</a>}
        <a class="hand-subtitle" href="/archive/">慢慢翻閱</a>
      </div>
    </div>
  </section>

  <section class="quiet-section quiet-latest wrap" aria-labelledby="latest-title">
    <header class="quiet-section__head">
      <div>
        <p class="kicker">LATEST NOTES</p>
        <h2 id="latest-title">Recent entries</h2>
      </div>
      <a class="quiet-link" href="/posts/">All posts</a>
    </header>

    <div class="quiet-note-list">
      {latest.map((post, index) => (
        <a class:list={['quiet-note', index === 0 && 'quiet-note--lead']} href={`/posts/${post.slug}/`}>
          <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
          <div>
            <strong>{post.data.title}</strong>
            {index === 0 && <p>{post.data.description || getExcerpt(post, 92)}</p>}
          </div>
          <span>{post.data.categories[0] ?? `${readingMinutes(post)} min`}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="quiet-section quiet-doorway wrap" aria-labelledby="browse-title">
    <figure class="quiet-doorway__media" aria-hidden="true" data-browse-media>
      <img src="/assets/img/Background/3.jpg" alt="" loading="lazy" />
    </figure>
    <header class="quiet-section__head quiet-section__head--center" data-browse-header>
      <div>
        <p class="kicker">BROWSE</p>
        <h2 id="browse-title" class="zh-thin">沉入。</h2>
      </div>
    </header>

    <nav class="quiet-doorway__list" aria-label="Browse the site">
      {browseItems.map((item) => (
        <a class="quiet-doorway__item" href={item.href}>
          <span>{item.number}</span>
          <strong>{item.title}</strong>
          <small>{item.description}</small>
        </a>
      ))}
    </nav>
  </section>

  <script type="application/json" id="hero-backgrounds" set:html={JSON.stringify(backgroundImages)}></script>
  <script>
    const dataElement = document.getElementById('hero-backgrounds');
    const heroImages = JSON.parse(dataElement?.textContent || '[]');
    const heroMedia = document.querySelector('[data-hero-media]');
    const heroImage = document.querySelector('[data-hero-image]');
    const heroTitle = document.querySelector('[data-hero-title]');
    const coverFolio = document.querySelector('[data-cover-folio]');
    const browseMedia = document.querySelector('[data-browse-media]');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const issuePalette = ['#b88655', '#7b9b82', '#8a9ebd', '#c48686', '#aa945f'];
    let currentImage = heroImage instanceof HTMLImageElement ? heroImage.getAttribute('src') : '';
    let ticking = false;
    let folioTimer;

    function pickImage() {
      if (!heroImages.length) return currentImage;
      const pool = heroImages.length > 1 ? heroImages.filter((image) => image !== currentImage) : heroImages;
      return pool[Math.floor(Math.random() * pool.length)] ?? heroImages[0];
    }

    function updateCoverFolio(nextImage, pulse = true) {
      const index = Math.max(0, heroImages.indexOf(nextImage));
      const label = String(index + 1).padStart(2, '0');
      if (coverFolio) {
        coverFolio.textContent = label;
        if (pulse && !reducedMotion.matches) {
          coverFolio.classList.remove('is-pulsing');
          window.clearTimeout(folioTimer);
          requestAnimationFrame(() => coverFolio.classList.add('is-pulsing'));
          folioTimer = window.setTimeout(() => coverFolio.classList.remove('is-pulsing'), 520);
        }
      }
      document.documentElement.style.setProperty('--issue-thread', issuePalette[index % issuePalette.length]);
    }

    function setHeroImage(nextImage, options = {}) {
      if (!(heroImage instanceof HTMLImageElement) || !nextImage || nextImage === currentImage) return;
      const delay = options.immediate || reducedMotion.matches ? 0 : 160;
      currentImage = nextImage;
      updateCoverFolio(nextImage, !options.immediate);
      heroMedia?.classList.add('is-switching');
      window.setTimeout(() => {
        heroImage.src = nextImage;
        const decoded = heroImage.decode ? heroImage.decode().catch(() => undefined) : Promise.resolve();
        decoded.finally(() => {
          heroMedia?.classList.remove('is-switching');
        });
      }, delay);
    }

    function updateParallax() {
      ticking = false;
      if (heroMedia instanceof HTMLElement && !reducedMotion.matches) {
        const rect = heroMedia.parentElement?.getBoundingClientRect();
        if (rect) {
          const factor = window.innerWidth < 921 ? 0.15 : 0.35;
          const shift = Math.max(0, -rect.top * factor);
          heroMedia.style.setProperty('--hero-parallax-y', `${shift}px`);
        }
      } else {
        heroMedia?.style.setProperty('--hero-parallax-y', '0px');
      }

      if (browseMedia instanceof HTMLElement && !reducedMotion.matches) {
        const rect = browseMedia.parentElement?.getBoundingClientRect();
        if (rect) {
          const shift = -rect.top * 0.4;
          browseMedia.style.setProperty('--browse-parallax-y', `${shift}px`);
        }
      } else {
        browseMedia?.style.setProperty('--browse-parallax-y', '0px');
      }
    }

    function requestParallax() {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(updateParallax);
    }

    const initialImage = pickImage();
    if (heroImage instanceof HTMLImageElement && initialImage) {
      currentImage = initialImage;
      heroImage.src = initialImage;
    }
    updateCoverFolio(currentImage, false);
    (heroImage instanceof HTMLImageElement && heroImage.decode
      ? heroImage.decode().catch(() => {})
      : Promise.resolve()
    ).finally(() => heroMedia?.classList.add('is-ready'));
    
    const browseImage = browseMedia?.querySelector('img');
    if (browseImage instanceof HTMLImageElement && heroImages.length > 0) {
      browseImage.src = pickImage();
    }

    updateParallax();
    window.addEventListener('scroll', requestParallax, { passive: true });
    window.addEventListener('resize', requestParallax);
    heroTitle?.addEventListener('click', () => setHeroImage(pickImage()));
  </script>
</BaseLayout>
