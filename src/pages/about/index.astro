---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../data/site';
import { getAllPosts, getCategories, getTags } from '../../utils/posts';

const posts = await getAllPosts();
const tags = getTags(posts);
const categories = getCategories(posts);
const links = [...site.social, ...site.resources];
---

<BaseLayout title="About" description={site.longDescription}>
  <section class="quiet-profile wrap" aria-labelledby="about-title">
    <aside class="quiet-profile__rail" aria-label="Profile metadata">
      <p class="kicker">ABOUT</p>

    </aside>

    <div class="quiet-profile__copy">
      <h1 id="about-title">honemik</h1>
      <p>
        This is a small personal archive for game notes, video and streaming fragments, study records,
        medical learning notes, and the quieter practical things that collect around a life online.
      </p>

    </div>

    <dl class="quiet-profile__stats" aria-label="Site statistics">
      <div><dt>Posts</dt><dd>{posts.length}</dd></div>
      <div><dt>Tags</dt><dd>{tags.length}</dd></div>
      <div><dt>Categories</dt><dd>{categories.length}</dd></div>
    </dl>
  </section>

  <section class="quiet-section quiet-links wrap" aria-labelledby="links-title">
    <header class="quiet-section__head">
      <div>
        <p class="kicker">LINKS</p>
        <h2 id="links-title">Places to find honemik</h2>
      </div>
    </header>

    <div class="quiet-link-list">
      {links.map((item, index) => (
        <a
          class="quiet-resource"
          href={item.href}
          target={item.href.startsWith('http') ? '_blank' : undefined}
          rel={item.href.startsWith('http') ? 'noopener' : undefined}
        >
          <span>{String(index + 1).padStart(2, '0')}</span>
          <strong>{item.label}</strong>
          <small>{'description' in item ? item.description : item.href.replace('mailto:', '')}</small>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
