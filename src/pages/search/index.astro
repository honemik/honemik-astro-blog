---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSearchSuggestions } from '../../utils/search';
import { formatDate, getAllPosts, getExcerpt } from '../../utils/posts';

const searchSuggestions = await getSearchSuggestions();
const recentPosts = (await getAllPosts()).slice(0, 10).map((post) => ({
  title: post.data.title,
  date: formatDate(post.data.date),
  description: post.data.description || getExcerpt(post, 140),
  url: `/posts/${post.slug}/`,
  terms: [...post.data.categories, ...post.data.tags].slice(0, 4)
}));
const serializeForScript = (value: unknown) => JSON.stringify(value).replaceAll('<', '\\u003c');
---

<BaseLayout title="Search" description="Search posts from the honemik blog archive.">
  <section class="quiet-search wrap" aria-labelledby="search-title">
    <div class="quiet-search__intro">
      <p class="kicker">FIND NOTES</p>
      <h1 id="search-title">Search</h1>
      <p>Look through titles, descriptions, categories, tags, and post bodies.</p>
    </div>

    <div class="quiet-search-line">
      <label for="site-search">Search posts</label>
      <input id="site-search" type="search" placeholder="Try Blog, Game, Tiddly..." autocomplete="off" data-search-input />
    </div>
  </section>

  <section class="quiet-section wrap" aria-label="Search results">
    <p class="quiet-search-count" data-search-count aria-live="polite"></p>
    <div class="quiet-search-results" data-search-results></div>
  </section>

  <script type="application/json" id="search-suggestions" set:html={serializeForScript(searchSuggestions)}></script>
  <script type="application/json" id="search-recent-posts" set:html={serializeForScript(recentPosts)}></script>
  <script type="module" is:inline>
    const input = document.querySelector('[data-search-input]');
    const searchLine = document.querySelector('.quiet-search-line');
    const results = document.querySelector('[data-search-results]');
    const count = document.querySelector('[data-search-count]');
    const suggestionElement = document.getElementById('search-suggestions');
    const recentElement = document.getElementById('search-recent-posts');
    const suggestions = JSON.parse(suggestionElement?.textContent || '[]');
    const recentPosts = JSON.parse(recentElement?.textContent || '[]');
    let compositionTimer;
    let pagefindPromise;
    let searchRequest = 0;

    function escapeHTML(value) {
      return String(value)
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;')
        .replaceAll("'", '&#39;');
    }

    function resultTemplate(post) {
      const terms = (post.terms || []).map((term) => `<span>${escapeHTML(term)}</span>`).join('');
      return `
        <a class="quiet-search-row" href="${escapeHTML(post.url)}">
          <time>${escapeHTML(post.date)}</time>
          <span class="quiet-search-row__body">
            <strong>${escapeHTML(post.title)}</strong>
            <p>${escapeHTML(post.description)}</p>
          </span>
          <span class="quiet-search-row__terms">${terms}</span>
        </a>
      `;
    }

    function normalizeResult(result) {
      const terms = Array.isArray(result.meta?.terms)
        ? result.meta.terms
        : result.meta?.terms
          ? [result.meta.terms]
          : [];

      return {
        title: result.meta?.title || 'Untitled note',
        date: result.meta?.date || '',
        description: result.plain_excerpt || '',
        url: result.url,
        terms
      };
    }

    function emptyTemplate() {
      const suggestionLinks = suggestions
        .map((item) => `
          <a href="${escapeHTML(item.url)}">
            <span>${escapeHTML(item.label)}</span>
            <small>${escapeHTML(item.count)} notes</small>
          </a>
        `)
        .join('');

      return `
        <div class="empty-state empty-state--suggestions">
          <p>No posts matched that search.</p>
          <nav aria-label="Suggested topics">${suggestionLinks}</nav>
        </div>
      `;
    }

    function renderRows(matches) {
      if (!results) return;
      results.classList.add('is-updating');
      results.innerHTML = matches.length
        ? matches.map(resultTemplate).join('')
        : emptyTemplate();
    }

    function updateCount(message) {
      if (!count) return;
      count.classList.add('is-updating');
      count.textContent = message;
      window.setTimeout(() => count.classList.remove('is-updating'), 160);
    }

    function finishUpdate() {
      window.setTimeout(() => {
        results?.classList.remove('is-updating');
        document.body.classList.remove('is-searching');
      }, 220);
    }

    function loadPagefind() {
      if (!pagefindPromise) {
        pagefindPromise = import('/pagefind/pagefind.js').then(async (pagefind) => {
          await pagefind.init();
          return pagefind;
        });
      }
      return pagefindPromise;
    }

    async function render(query = '') {
      const normalized = query.trim();
      const request = ++searchRequest;

      if (!normalized) {
        updateCount(`Showing ${recentPosts.length} recent note${recentPosts.length === 1 ? '' : 's'}`);
        renderRows(recentPosts);
        finishUpdate();
        return;
      }

      document.body.classList.add('is-searching');
      updateCount('Searching…');

      try {
        const pagefind = await loadPagefind();
        const search = await pagefind.debouncedSearch(normalized, {}, 180);
        if (!search || request !== searchRequest) return;

        const matches = await Promise.all(search.results.slice(0, 50).map((result) => result.data()));
        if (request !== searchRequest) return;

        updateCount(`${search.results.length} result${search.results.length === 1 ? '' : 's'}`);
        renderRows(matches.map(normalizeResult));
      } catch {
        if (request !== searchRequest) return;
        updateCount('Search is unavailable');
        if (results) {
          results.innerHTML = '<div class="empty-state"><p>The search index is generated by the production build. Please try again after running the build.</p></div>';
        }
      } finally {
        if (request === searchRequest) finishUpdate();
      }
    }

    input?.addEventListener('focus', () => {
      loadPagefind().catch(() => undefined);
    }, { once: true });

    input?.addEventListener('input', (event) => {
      searchLine?.classList.add('is-composing');
      window.clearTimeout(compositionTimer);
      compositionTimer = window.setTimeout(() => searchLine?.classList.remove('is-composing'), 260);
      void render(event.target instanceof HTMLInputElement ? event.target.value : '');
    });

    void render('');
  </script>
</BaseLayout>
