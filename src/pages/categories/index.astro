---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import { getAllPosts, getCategories } from '../../utils/posts';

const categories = getCategories(await getAllPosts());
---

<BaseLayout title="Categories" description="Categories used across the honemik blog archive.">
  <section class="page-hero wrap">
    <SectionHeader eyebrow="Browse" title="Categories" description="The source blog used categories sparingly; preserved here when available." align="center" />
    <div class="term-cloud term-cloud--large term-cloud--center">
      {categories.map(([category, count]) => <a href={`/categories/${category.toLowerCase()}/`}>{category}<span>{count}</span></a>)}
    </div>
  </section>
</BaseLayout>
