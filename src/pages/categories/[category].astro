---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import { formatDate, getAllPosts, getCategories, getExcerpt, readingMinutes, termSlug } from '../../utils/posts';

export async function getStaticPaths() {
  const posts = await getAllPosts();
  return getCategories(posts).map(([category]) => ({
    params: { category: termSlug(category) },
    props: { category }
  }));
}

const { category } = Astro.props;
const posts = (await getAllPosts()).filter((post) => post.data.categories.some((item) => termSlug(item) === termSlug(category)));
---

<BaseLayout title={`Category: ${category}`} description={`Posts in category ${category}.`}>
  <section class="page-hero wrap page-hero--editorial">
    <SectionHeader eyebrow="Category" title={category} description={`${posts.length} posts collected in this category.`} align="center" level={1} />
  </section>
  <section class="section-pad section-pad--topless editorial-archive">
    <div class="wrap department-post-list">
      {posts.map((post, index) => (
        <div class="department-post-shell" data-mobile-meta>
          <a class="department-post-row" href={`/posts/${post.slug}/`}>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <div>
              <strong>{post.data.title}</strong>
              <p>{post.data.description || getExcerpt(post, 96)}</p>
            </div>
            <div class="meta-row">
              <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
              <span>{readingMinutes(post)} min</span>
            </div>
          </a>
          <button class="mobile-meta-toggle" type="button" aria-expanded="false">
            <span class="visually-hidden">Show note metadata</span>
          </button>
          <div class="mobile-row-meta" hidden>
            <span>{formatDate(post.data.date)}</span>
            <span>{readingMinutes(post)} min read</span>
          </div>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
