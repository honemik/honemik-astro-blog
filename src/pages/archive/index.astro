---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import { formatDate, getAllPosts, groupPostsByYear, readingMinutes } from '../../utils/posts';

const posts = await getAllPosts();
const years = groupPostsByYear(posts);
---

<BaseLayout title="Archive" description="Chronological archive of honemik blog posts.">
  <section class="page-hero wrap page-hero--editorial">
    <SectionHeader eyebrow="Timeline" title="Archive" description="A date-first view of every migrated post." align="center" />
  </section>

  <section class="section-pad section-pad--topless editorial-archive">
    <div class="wrap editorial-archive__shell">
      <nav class="archive-bookmark-rail" aria-label="Archive year bookmarks">
        {years.map(([year], index) => (
          <a href={`#archive-year-${year}`} data-bookmark-link aria-current={index === 0 ? 'true' : undefined}>
            <span>{year}</span>
          </a>
        ))}
      </nav>
      <div class="editorial-archive__list">
      {years.map(([year, entries]) => (
        <section class="editorial-year" id={`archive-year-${year}`} aria-labelledby={`year-${year}`} data-year-section>
          <div class="editorial-year__rail">
            <p class="kicker">YEAR</p>
            <h2 id={`year-${year}`}>{year}</h2>
            <span>{entries.length} posts</span>
          </div>
          <div class="editorial-year__content">
            <div class="archive-row-list">
            {entries.map((post) => (
              <div class="archive-row-shell" data-mobile-meta>
                <a href={`/posts/${post.slug}/`} class="archive-row">
                  <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
                  <span class="archive-row__body">
                    <strong>{post.data.title}</strong>
                    <small class="archive-row__preview">{post.data.categories[0] ?? post.data.tags[0] ?? 'Note'}</small>
                  </span>
                  <span>{readingMinutes(post)} min</span>
                </a>
                <button class="mobile-meta-toggle" type="button" aria-expanded="false">
                  <span class="visually-hidden">Show note metadata</span>
                </button>
                <div class="mobile-row-meta" hidden>
                  <span>{post.data.categories[0] ?? post.data.tags[0] ?? 'Note'}</span>
                  <span>{readingMinutes(post)} min read</span>
                </div>
              </div>
            ))}
            </div>
          </div>
        </section>
      ))}
      </div>
    </div>
  </section>
</BaseLayout>
