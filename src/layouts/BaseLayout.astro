---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site as siteMeta } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  type?: string;
}

const {
  title = siteMeta.title,
  description = siteMeta.description,
  image = siteMeta.defaultImage,
  canonical = Astro.url.pathname,
  type = 'website'
} = Astro.props;

const pageTitle = title === siteMeta.title ? siteMeta.title : `${title} | ${siteMeta.title}`;
const canonicalUrl = new URL(canonical, siteMeta.url).toString();
const imageUrl = image.startsWith('http') ? image : new URL(image, siteMeta.url).toString();
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f6efdc" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={`${siteMeta.title} RSS`} href="/rss.xml" />
    <link href="/assets/fonts/zen-maru-gothic.css" rel="stylesheet" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <Header />
    <div class="page-transition-folio" aria-hidden="true" data-page-transition-folio>{title}</div>
    <div class="quiet-loading-folio" aria-hidden="true"></div>
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <script>
      (() => {
        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
        const supportsObserver = 'IntersectionObserver' in window;
        const root = document.documentElement;
        const transitionFolio = document.querySelector('[data-page-transition-folio]');
        root.classList.add('motion-ready');

        const pendingLabel = sessionStorage.getItem('next-page-label');
        if (pendingLabel && transitionFolio instanceof HTMLElement && !reducedMotion.matches) {
          transitionFolio.textContent = pendingLabel;
          transitionFolio.classList.add('is-visible');
          window.setTimeout(() => transitionFolio.classList.remove('is-visible'), 460);
          sessionStorage.removeItem('next-page-label');
        }

        const revealTargets = [
          ...document.querySelectorAll('.quiet-section, .page-hero--editorial, .quiet-search, .editorial-year, .department-term-grid, .department-post-list, .article-editorial-hero, .post-neighbors')
        ];
        const detailTargets = [
          ...new Set(document.querySelectorAll('.article-cover, .caption, figcaption, .prose blockquote'))
        ];

        revealTargets.forEach((target) => target.classList.add('magazine-settle'));
        detailTargets.forEach((target) => target.classList.add('magazine-detail'));

        if (!supportsObserver || reducedMotion.matches) {
          [...revealTargets, ...detailTargets].forEach((target) => target.classList.add('is-visible'));
        } else {
          const revealObserver = new IntersectionObserver((entries, observer) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            });
          }, { rootMargin: '0px 0px 18% 0px', threshold: 0.04 });

          [...revealTargets, ...detailTargets].forEach((target) => revealObserver.observe(target));
        }

        const yearGroups = [...document.querySelectorAll('.editorial-year')];
        if (yearGroups.length && supportsObserver && !reducedMotion.matches) {
          const yearObserver = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              entry.target.classList.toggle('is-current', entry.isIntersecting);
            });
          }, { rootMargin: '-28% 0px -56% 0px', threshold: 0 });

          yearGroups.forEach((group) => yearObserver.observe(group));
        } else {
          yearGroups[0]?.classList.add('is-current');
        }

        const progress = document.querySelector('[data-article-progress]');
        const articleBody = document.querySelector('[data-article-body]');
        if (progress instanceof HTMLElement && articleBody instanceof HTMLElement && !reducedMotion.matches) {
          let ticking = false;

          const updateProgress = () => {
            ticking = false;
            const rect = articleBody.getBoundingClientRect();
            const scrollable = Math.max(rect.height - window.innerHeight, 1);
            const current = Math.min(1, Math.max(0, -rect.top / scrollable));
            progress.style.setProperty('--article-progress', String(current));
          };

          const requestProgress = () => {
            if (ticking) return;
            ticking = true;
            window.requestAnimationFrame(updateProgress);
          };

          updateProgress();
          window.addEventListener('scroll', requestProgress, { passive: true });
          window.addEventListener('resize', requestProgress);
        }

        const tocLinks = [...document.querySelectorAll('[data-toc-link]')];
        const tocTargets = tocLinks
          .map((link) => {
            const id = link instanceof HTMLAnchorElement ? decodeURIComponent(link.hash.slice(1)) : '';
            const target = id ? document.getElementById(id) : null;
            return target ? { link, target } : null;
          })
          .filter(Boolean);

        if (tocTargets.length && supportsObserver) {
          const setActiveToc = (activeLink) => {
            tocLinks.forEach((link) => {
              if (!(link instanceof HTMLElement)) return;
              const isActive = link === activeLink;
              link.classList.toggle('is-active', isActive);
              if (isActive) {
                link.setAttribute('aria-current', 'location');
              } else {
                link.removeAttribute('aria-current');
              }
            });
          };

          const tocObserver = new IntersectionObserver((entries) => {
            const visible = entries
              .filter((entry) => entry.isIntersecting)
              .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
            if (!visible) return;
            const match = tocTargets.find((item) => item?.target === visible.target);
            if (match?.link instanceof HTMLElement) setActiveToc(match.link);
          }, { rootMargin: '-24% 0px -62% 0px', threshold: 0 });

          tocTargets.forEach((item) => item?.target && tocObserver.observe(item.target));
          if (tocLinks[0] instanceof HTMLElement) setActiveToc(tocLinks[0]);
        }

        const bookmarkLinks = [...document.querySelectorAll('[data-bookmark-link]')];
        const bookmarkSections = [...document.querySelectorAll('[data-year-section]')];
        if (bookmarkLinks.length && bookmarkSections.length && supportsObserver) {
          const setBookmark = (section) => {
            bookmarkLinks.forEach((link) => {
              if (!(link instanceof HTMLAnchorElement)) return;
              const isActive = link.hash.slice(1) === section.id;
              if (isActive) {
                link.setAttribute('aria-current', 'true');
              } else {
                link.removeAttribute('aria-current');
              }
            });
          };

          const bookmarkObserver = new IntersectionObserver((entries) => {
            const active = entries
              .filter((entry) => entry.isIntersecting)
              .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
            if (active?.target instanceof HTMLElement) setBookmark(active.target);
          }, { rootMargin: '-28% 0px -58% 0px', threshold: 0 });

          bookmarkSections.forEach((section) => bookmarkObserver.observe(section));
        }

        document.querySelectorAll('[data-mobile-meta]').forEach((item) => {
          const button = item.querySelector('.mobile-meta-toggle');
          const panel = item.querySelector('.mobile-row-meta');
          if (!(button instanceof HTMLButtonElement) || !(panel instanceof HTMLElement)) return;

          button.addEventListener('click', () => {
            const isOpen = button.getAttribute('aria-expanded') === 'true';
            button.setAttribute('aria-expanded', String(!isOpen));
            item.classList.toggle('is-meta-open', !isOpen);
            panel.hidden = isOpen;
          });
        });

        document.querySelectorAll('[data-copy-link]').forEach((button) => {
          if (!(button instanceof HTMLButtonElement)) return;
          const label = button.querySelector('[data-copy-label]');
          const defaultText = label?.textContent || 'Copy link';
          let resetTimer;

          button.addEventListener('click', async () => {
            const url = button.dataset.copyUrl || window.location.href;
            try {
              await navigator.clipboard.writeText(url);
              button.classList.add('is-copied');
              if (label) label.textContent = 'Copied';
              window.clearTimeout(resetTimer);
              resetTimer = window.setTimeout(() => {
                button.classList.remove('is-copied');
                if (label) label.textContent = defaultText;
              }, 1800);
            } catch {
              button.classList.add('is-error');
              if (label) label.textContent = 'Copy failed';
              window.clearTimeout(resetTimer);
              resetTimer = window.setTimeout(() => {
                button.classList.remove('is-error');
                if (label) label.textContent = defaultText;
              }, 2200);
            }
          });
        });

        document.addEventListener('click', (event) => {
          if (event.defaultPrevented || reducedMotion.matches) return;
          if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
          const link = event.target instanceof Element ? event.target.closest('a[href]') : null;
          if (!(link instanceof HTMLAnchorElement)) return;
          if (link.target || link.hasAttribute('download')) return;
          const url = new URL(link.href, window.location.href);
          if (url.origin !== window.location.origin) return;
          if (url.pathname === window.location.pathname && url.hash) return;

          event.preventDefault();
          const label = link.textContent?.trim().replace(/\s+/g, ' ').slice(0, 36) || document.title;
          sessionStorage.setItem('next-page-label', label);
          document.body.classList.add('is-navigating');
          if (transitionFolio instanceof HTMLElement) {
            transitionFolio.textContent = label;
            transitionFolio.classList.add('is-visible');
          }
          window.setTimeout(() => {
            window.location.href = url.toString();
          }, 140);
        });
      })();
    </script>
  </body>
</html>
